rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Same policy as firestore.rules: open editing, anonymous auth required
    // for writes to keep the bucket from being a fully open write target.
    match /cover/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /zones/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
