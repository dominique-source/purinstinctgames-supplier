rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Editing is intentionally open to anyone with the link (no passcode) —
    // this app is an internal team tool. Anonymous auth is still required
    // for writes so random unauthenticated scripts can't hit the database.
    match /cover/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /zones/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
